{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
  "Key": "RailwayReservationSystemSuperSecretKey123456789",
  "Issuer": "RailwayReservationSystem",
  "Audience": "RailwayReservationSystemClient",
  "ExpiryMinutes": 60
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "auth-swagger-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/swagger-docs/Auth/swagger.json"
        },
        "Transforms": [
          { "PathSet": "/swagger/v1/swagger.json" }
        ]
      },
      "train-swagger-route": {
        "ClusterId": "train-cluster",
        "Match": {
          "Path": "/swagger-docs/Train/swagger.json"
        },
        "Transforms": [
          { "PathSet": "/swagger/v1/swagger.json" }
        ]
      },
      "booking-swagger-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/swagger-docs/Booking/swagger.json"
        },
        "Transforms": [
          { "PathSet": "/swagger/v1/swagger.json" }
        ]
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "user-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "role-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "fare-route": {
        "ClusterId": "train-cluster",
        "Match": {
          "Path": "/api/fares/{**catch-all}"
        }
      },
      "schedule-route": {
        "ClusterId": "train-cluster",
        "Match": {
          "Path": "/api/schedules/{**catch-all}"
        }
      },
      "train-route": {
        "ClusterId": "train-cluster",
        "Match": {
          "Path": "/api/trains/{**catch-all}"
        }
      },
      "seat-route": {
        "ClusterId": "train-cluster",
        "Match": {
          "Path": "/api/seats/{**catch-all}"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/Bookings/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "train-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  }
}